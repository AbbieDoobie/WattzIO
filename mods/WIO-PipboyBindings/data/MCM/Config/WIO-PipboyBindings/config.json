                        "options": [
                            "$PPF_GP_SameAsOpen",
                            "$PPF_GP_Off",
                            "$PPF_GP_DPadUp",
                            "$PPF_GP_DPadDown",
                            "$PPF_GP_DPadLeft",
                            "$PPF_GP_DPadRight",
                            "$PPF_GP_Start",
                            "$PPF_GP_Back",
                            "$PPF_GP_LS",
                            "$PPF_GP_RS",
                            "$PPF_GP_LB",
                            "$PPF_GP_RB",
                            "$PPF_GP_A",
                            "$PPF_GP_B",
                            "$PPF_GP_X",
                            "$PPF_GP_Y",
                            "$PPF_GP_LT",
                            "$PPF_GP_RT"
