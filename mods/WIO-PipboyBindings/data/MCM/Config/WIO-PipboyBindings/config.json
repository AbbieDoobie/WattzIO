                    "help": "$PPF_CloseGP_Help",
                    "valueOptions": {
                        "sourceType": "ModSettingInt",
                        "options": [
                            "$PPF_GP_SameAsOpen",
                            "$PPF_GP_Off",
                            "$PPF_GP_DPadUp",
                            "$PPF_GP_DPadDown",
                            "$PPF_GP_DPadLeft",
                            "$PPF_GP_DPadRight",
                            "$PPF_GP_Start",
                            "$PPF_GP_Back",
                            "$PPF_GP_LS",
                            "$PPF_GP_RS",
                            "$PPF_GP_LB",
                            "$PPF_GP_RB",
                            "$PPF_GP_A",
                            "$PPF_GP_B",
                            "$PPF_GP_X",
                            "$PPF_GP_Y",
                            "$PPF_GP_LT",
                            "$PPF_GP_RT"
                        ]
                    }
                },
                {
                    "id": "CloseKeyboardHotkey",
                    "text": "$PPF_CloseKB_Text",
                    "type": "hotkey",
                    "help": "$PPF_CloseKB_Help"
                },
                {
                    "type": "text",
                    "html": true,
                    "text": "<font color='#AAAAAA' size='14'>$PPF_Close_FallUITip</font>"
                },
                {
                    "type": "section",
                    "text": "$PPF_Order_Sect"
